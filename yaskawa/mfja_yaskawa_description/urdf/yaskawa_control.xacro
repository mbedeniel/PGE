<?xml version="1.0"?>
<!--
  Chooses the ros2_control part of the description:
    gz_sim=true             Gazebo (gazebo/yaskawa_gazebo.urdf.xacro)
    use_mock_hardware=true  mock hardware (ros2_control/yaskawa_mock.ros2_control.xacro)
    use_real_hardware=true  real arm through MotoROS2 (ros2_control/yaskawa_motoros2.ros2_control.xacro)
    all false               no ros2_control tag (display only)
  The first true one wins, in this order. The real hardware is never chosen by default.
  The joint interfaces are the same in every case (ros2_control/yaskawa_joints.xacro). The gripper is
  added as a second ros2_control system (ros2_control/yaskawa_gripper.ros2_control.xacro): MotoROS2 IO
  on the real arms, a copy of the commands to the states in the mock and in Gazebo.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find mfja_yaskawa_description)/gazebo/yaskawa_gazebo.urdf.xacro"/>
  <xacro:include filename="$(find mfja_yaskawa_description)/ros2_control/yaskawa_mock.ros2_control.xacro"/>
  <xacro:include filename="$(find mfja_yaskawa_description)/ros2_control/yaskawa_motoros2.ros2_control.xacro"/>
  <xacro:include filename="$(find mfja_yaskawa_description)/ros2_control/yaskawa_gripper.ros2_control.xacro"/>

  <xacro:macro name="yaskawa_control"
               params="name prefix gz_sim use_mock_hardware use_real_hardware robot_namespace
                       controller_params_file initial_positions_file">
    <xacro:property name="use_gz" value="${str(gz_sim).lower() == 'true'}"/>
    <xacro:property name="use_mock" value="${str(use_mock_hardware).lower() == 'true'}"/>
    <xacro:property name="use_real" value="${str(use_real_hardware).lower() == 'true'}"/>
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)}"/>

    <xacro:if value="${use_gz}">
      <xacro:yaskawa_gazebo name="${name}" prefix="${prefix}"
                            initial_positions="${initial_positions}"
                            robot_namespace="${robot_namespace}"
                            controller_params_file="${controller_params_file}"/>
      <xacro:yaskawa_gripper_gz_ros2_control name="${name}_gripper" prefix="${prefix}"/>
    </xacro:if>
    <xacro:if value="${use_mock and not use_gz}">
      <xacro:yaskawa_mock_ros2_control name="${name}" prefix="${prefix}"
                                       initial_positions="${initial_positions}"/>
      <xacro:yaskawa_gripper_mock_ros2_control name="${name}_gripper" prefix="${prefix}"/>
    </xacro:if>
    <xacro:if value="${use_real and not use_gz and not use_mock}">
      <xacro:yaskawa_motoros2_ros2_control name="${name}" prefix="${prefix}"
                                           robot_namespace="${robot_namespace}"/>
      <xacro:yaskawa_gripper_io_ros2_control name="${name}_gripper" prefix="${prefix}"
                                             robot_namespace="${robot_namespace}"/>
    </xacro:if>
  </xacro:macro>
</robot>
