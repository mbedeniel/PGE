<?xml version="1.0"?>
<!--
  ros2_control system without simulator: mock_components/GenericSystem copies each
  command to the matching state. First test step for the controllers (poly ch. 22.8.2).

  Same joint interfaces as the real arms (ros2_control/yaskawa_joints.xacro), so that the mock
  rehearses the real controller configuration. calculate_dynamics stays off: the mock refuses two
  command interfaces per joint when it integrates the dynamics itself.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find mfja_yaskawa_description)/ros2_control/yaskawa_joints.xacro"/>

  <xacro:macro name="yaskawa_mock_ros2_control" params="name prefix initial_positions">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <xacro:yaskawa_position_velocity_joints prefix="${prefix}" initial_positions="${initial_positions}"/>
    </ros2_control>
  </xacro:macro>
</robot>
