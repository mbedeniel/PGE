<?xml version="1.0"?>
<!--
  ros2_control system of a real arm: motoros2_hw_interfaces/MotoROS2HardwareInterface.

  The plugin runs on the PC. It reads <ns>/joint_states published by MotoROS2 and sends the
  command of every control cycle to the MotoROS2 service <ns>/queue_traj_point (point-queue
  mode). Nothing is installed on the robot controller.

  Requirements of the plugin:
    - exactly two command interfaces per joint, position then velocity;
    - exactly two state interfaces per joint, position then velocity;
    - joint names equal to the MotoROS2 ones (joint_1 ... joint_6 at the MFJA).
  Do not set the plugin parameter throttle_duration_ms: in this version of the plugin it is
  read only when absent, and a value given here leaves the log throttle uninitialised.
  is_async="true" runs read/write in their own thread: write() waits for each service reply.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find mfja_yaskawa_description)/ros2_control/yaskawa_joints.xacro"/>

  <xacro:macro name="yaskawa_motoros2_ros2_control" params="name prefix robot_namespace">
    <xacro:property name="ns" value="${'/' + robot_namespace.strip('/') if robot_namespace.strip('/') else ''}"/>
    <ros2_control name="${name}" type="system" is_async="true">
      <hardware>
        <plugin>motoros2_hw_interfaces/MotoROS2HardwareInterface</plugin>
        <param name="queue_traj_point_srv_name">${ns}/queue_traj_point</param>
        <param name="joint_states_topic_name">${ns}/joint_states</param>
      </hardware>
      <xacro:yaskawa_position_velocity_joints prefix="${prefix}"/>
    </ros2_control>
  </xacro:macro>
</robot>
