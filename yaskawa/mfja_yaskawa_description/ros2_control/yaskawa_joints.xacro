<?xml version="1.0"?>
<!-- ros2_control joint block shared by the Gazebo and mock systems: 6 joints, position commands. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="yaskawa_position_joint" params="joint initial">
    <joint name="${joint}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="yaskawa_position_joints" params="prefix initial_positions">
    <xacro:yaskawa_position_joint joint="${prefix}joint_1" initial="${initial_positions['joint_1']}"/>
    <xacro:yaskawa_position_joint joint="${prefix}joint_2" initial="${initial_positions['joint_2']}"/>
    <xacro:yaskawa_position_joint joint="${prefix}joint_3" initial="${initial_positions['joint_3']}"/>
    <xacro:yaskawa_position_joint joint="${prefix}joint_4" initial="${initial_positions['joint_4']}"/>
    <xacro:yaskawa_position_joint joint="${prefix}joint_5" initial="${initial_positions['joint_5']}"/>
    <xacro:yaskawa_position_joint joint="${prefix}joint_6" initial="${initial_positions['joint_6']}"/>
  </xacro:macro>
</robot>
