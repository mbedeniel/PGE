<?xml version="1.0"?>
<!--
  ros2_control joint block of the 6 joints, the same for every hardware (real arms, mock, Gazebo):
  commands position and velocity, states position and velocity. The MotoROS2 hardware interface of
  the real arms requires exactly these interfaces, in this order; the mock and the Gazebo system
  (mfja_yaskawa_gz_hardware) expose the same ones.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="yaskawa_position_velocity_joint" params="joint initial">
    <joint name="${joint}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <xacro:if value="${str(initial) != ''}">
          <param name="initial_value">${initial}</param>
        </xacro:if>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- initial_positions: dictionary joint -> value, or empty (real arms: the state comes from MotoROS2). -->
  <xacro:macro name="yaskawa_position_velocity_joints" params="prefix initial_positions:=''">
    <xacro:property name="init" value="${initial_positions if initial_positions else dict()}"/>
    <xacro:yaskawa_position_velocity_joint joint="${prefix}joint_1" initial="${init.get('joint_1', '')}"/>
    <xacro:yaskawa_position_velocity_joint joint="${prefix}joint_2" initial="${init.get('joint_2', '')}"/>
    <xacro:yaskawa_position_velocity_joint joint="${prefix}joint_3" initial="${init.get('joint_3', '')}"/>
    <xacro:yaskawa_position_velocity_joint joint="${prefix}joint_4" initial="${init.get('joint_4', '')}"/>
    <xacro:yaskawa_position_velocity_joint joint="${prefix}joint_5" initial="${init.get('joint_5', '')}"/>
    <xacro:yaskawa_position_velocity_joint joint="${prefix}joint_6" initial="${init.get('joint_6', '')}"/>
  </xacro:macro>

</robot>
