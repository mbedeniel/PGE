+def _start_after_processes_exit(
+    processes,
+    actions,
+    delay_s=0.0,
+    fallback_s=GUI_FALLBACK_START_S,
+):
+    """Return entities that start `actions` once every process in `processes` exits.
+
+    The Gazebo GUI ignores world updates until it has processed its first
+    snapshot of the world. A model spawned while the GUI is still starting up
+    is therefore never shown, even though it exists in the simulation.
+    Starting the GUI only after the spawn processes have finished puts every
+    spawned model in that first snapshot, whatever the machine's speed.
+    """
+    if not processes:
+        return list(actions)
+
+    pending = {id(process) for process in processes}
+    state = {'started': False}
+
+    def start(_context=None, wait_s=0.0):
+        if state['started']:
+            return None
+        state['started'] = True
+        if wait_s > 0.0:
+            return [TimerAction(period=wait_s, actions=list(actions))]
+        return list(actions)
+
+    def on_exit(event, _context):
+        pending.discard(id(event.action))
+        if pending:
+            return None
+        return start(wait_s=delay_s)
+
+    entities = [
+        RegisterEventHandler(OnProcessExit(target_action=process, on_exit=on_exit))
+        for process in processes
+    ]
+    entities.append(
+        TimerAction(period=fallback_s, actions=[OpaqueFunction(function=start)])
+    )
+    return entities
+
